# Server
PORT=3001

# Basic HTTP Auth — viewer account (e.g. the client)
DASH_USER=bas
DASH_PASS=changeme

# Basic HTTP Auth — admin account, gets access to Rapporten uploads
ADMIN_USER=admin
ADMIN_PASS=changeme

# Google Analytics 4
# Path to the service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GA4 Property ID
GA4_PROPERTY_ID=368911252

# SMTP — required for the mailed actiepunten-rapporten (weekly + monthly).
# If left unset, the site reports still work; only the emailed reports fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Recipient of the actiepunten-rapporten. Defaults to bojan@studiovanderheide.nl.
REPORT_EMAIL_TO=bojan@studiovanderheide.nl
