# Server
PORT=3001

# Basic HTTP Auth — viewer account (e.g. the client)
DASH_USER=bas
DASH_PASS=changeme

# Basic HTTP Auth — admin account, gets access to Rapporten uploads
ADMIN_USER=admin
ADMIN_PASS=changeme

# Google Analytics 4
# Path to the service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# GA4 Property ID
GA4_PROPERTY_ID=368911252

# SMTP — required for the mailed actiepunten-rapporten (weekly + monthly).
# Can also be set by the admin on the AI-instellingen tab (recommended); the
# tab's settings win over these env vars when both are present. If neither is
# set, the site reports still work; only the emailed reports fail.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
# Recipient of the actiepunten-rapporten. Defaults to bojan@studiovanderheide.nl.
REPORT_EMAIL_TO=bojan@studiovanderheide.nl

# Encrypts the AI provider API keys and the SMTP password at rest in
# data/ai-settings.json. Generate with: openssl rand -base64 32
# If unset, a key is generated automatically on first run and stored in
# data/.encryption-key (0600) — fine for a single server, but set this
# explicitly if data/ is backed up or synced anywhere, and keep it outside
# of any backup that also contains data/ (otherwise the backup carries both
# the ciphertext and the key that opens it).
SETTINGS_ENCRYPTION_KEY=
